# --- Database ---
# PostgreSQL for production. For quick local dev you may use sqlite:
#   DATABASE_URL=sqlite:///./swingdesk.db
DATABASE_URL=postgresql+psycopg2://swingdesk:swingdesk@localhost:5432/swingdesk

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins allowed by CORS (frontend dev server + production domain, or * for all)
CORS_ORIGINS=*

# --- LLM ranking layer (optional; deterministic ranking is the fallback) ---
# Provider is chosen in Settings -> LLM re-ranking. Each uses its OWN official
# SDK (no base_url shims) and reads its own key below.

# llm_provider = "anthropic"   → pip install anthropic   → model  claude-sonnet-4-6
ANTHROPIC_API_KEY=

# llm_provider = "openrouter"  → pip install openrouter  → model  anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=

# --- Angel One SmartAPI (server-side only, never sent to the frontend) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Zerodha Kite Connect (server-side only) ---
KITE_API_KEY=
KITE_API_SECRET=
# Access token is obtained via the request-token flow at runtime and cached here optionally
KITE_ACCESS_TOKEN=
